{
  "expo": {
    "name": "Perkify",
    "slug": "perkify",
    "scheme": "perkify",
    "version": "1.0.0",
    "icon": "./assets/app-icon-dark.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "apiBaseUrl": ""
    },
    "ios": {
      "icon": "./assets/app-icon-dark.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3A4F4A"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3A4F4A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0F0F0F"
          }
        }
      ],
      "expo-router",
      "expo-notifications",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Perkify to use Face ID to secure your account."
        }
      ]
    ],
    "platforms": [
      "ios",
      "android"
    ]
  }
}
